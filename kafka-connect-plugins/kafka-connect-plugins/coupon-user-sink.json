{
  "name": "mysql-sink-connector",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    
    # 쿠폰 발급과 로그인 관련 토픽 설정
    "topics": "user-login,coupon-issue",  # 이 토픽들에서 데이터를 수집
    
    # MySQL 연결 설정
    "connection.url": "jdbc:mysql://mysql:3306/coupon",  # MySQL 연결 URL
    "connection.user": "root",  # MySQL 사용자명
    "connection.password": "${MYSQL_PASSWORD}",  # MySQL 비밀번호 환경 변수로 연결
    
    # MySQL 데이터 삽입 설정
    "insert.mode": "insert",  # 데이터 삽입 모드 설정
    "auto.create": "true",    # 테이블 자동 생성 (필요시)

    # Kafka Avro Converter 설정 (데이터 포맷이 Avro로 되어 있으면 이 설정을 사용)
    "key.converter": "io.confluent.connect.avro.AvroConverter",  
    "value.converter": "io.confluent.connect.avro.AvroConverter",

    "key.converter.schema.registry.url": "http://schema-registry:8081",  # Avro 스키마 레지스트리 URL
    "value.converter.schema.registry.url": "http://schema-registry:8081",

    # 각 테이블의 이름을 topic에 맞게 자동으로 매핑하기 위해 table name 형식 설정
    "table.name.format": "${topic}",  # topic이 테이블 이름으로 사용됨 (예: user-login → user_login 테이블)
    
    # Primary Key 및 필수 필드 지정
    "pk.mode": "record_key",         # 기본키로 record key 사용
    "pk.fields": "user_id,coupon_id",  # user_id와 coupon_id를 primary key로 설정 (쿠폰 발급의 경우)
    
    # 필요한 컬럼만 저장하도록 필드 지정 (로그인 및 쿠폰 발급 관련)
    "fields.whitelist": "user_id, username, email, coupon_id, issued_at"  # 필요한 컬럼만 whitelist에 추가
  }
}
